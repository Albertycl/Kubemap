    "uid": "e877dc40-8d8a-43c6-a1e9-8479239d05e4"
   },
   "spec": {
    "replicas": 1,
    "selector": {
     "matchLabels": {
      "app.kubernetes.io/name": "checkout",
      "pod-template-hash": "5869b76bbb"
     }
    },
    "template": {
     "metadata": {
      "labels": {
       "app.kubernetes.io/name": "checkout",
       "app.kubernetes.io/part-of": "kubemap-demo",
       "kubemap.io/scenario": "crashloop",
       "pod-template-hash": "5869b76bbb"
      }
     },
     "spec": {
      "automountServiceAccountToken": false,
      "containers": [
       {
        "command": [
         "sh",
         "-c",
         "echo \"checkout starting (log level $LOG_LEVEL)\"\nif [ -z \"$DATABASE_URL\" ]; then\n  echo \"FATAL: required setting DATABASE_URL is not set (ConfigMap checkout-config)\" >&2\n  exit 1\nfi\necho \"connected to $DATABASE_URL\"; exec sleep 3600\n"
        ],
        "env": [
         {
          "name": "DATABASE_URL",
          "valueFrom": {
           "configMapKeyRef": {
            "key": "DATABASE_URL",
            "name": "checkout-config",
            "optional": true
           }
          }
         },
         {
          "name": "LOG_LEVEL",
          "valueFrom": {
           "configMapKeyRef": {
            "key": "LOG_LEVEL",
            "name": "checkout-config",
            "optional": true
           }
          }
         }
        ],
        "image": "busybox:1.36",
        "imagePullPolicy": "IfNotPresent",
        "name": "checkout",
        "resources": {
         "limits": {
          "cpu": "50m",
          "memory": "6Mi"
         },
         "requests": {
          "cpu": "5m",
          "memory": "6Mi"
         }
        },
        "securityContext": {
         "allowPrivilegeEscalation": false,
         "capabilities": {
          "drop": [
           "ALL"
          ]
         },
         "readOnlyRootFilesystem": true
        },
        "terminationMessagePath": "/dev/termination-log",
        "terminationMessagePolicy": "File"
       }
      ],
      "dnsPolicy": "ClusterFirst",
      "restartPolicy": "Always",
      "schedulerName": "default-scheduler",
      "securityContext": {
       "runAsNonRoot": true,
       "runAsUser": 65534,
       "seccompProfile": {
        "type": "RuntimeDefault"
       }
      },
